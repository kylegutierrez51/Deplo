# Environment for the integration and E2E tiers. Copy to .env.test:
#
#   cp .env.test.example .env.test
#
# Every value here is a throwaway, the same kind CI uses. Nothing reaches a real
# service: the GitHub OAuth provider is never contacted (E2E creates its own
# session cookie with AUTH_SECRET), and ENCRYPTION_KEY only has to exist so
# lib/utils/crypto.ts can initialise.

# A separate database in the docker compose Postgres. Integration tests truncate
# every table between cases, so this must not be your dev database; the setup
# refuses to run against a URL that looks like one. Create it once with:
#
#   docker exec deplo-postgres createdb -U deplo deplo_test
DATABASE_URL="postgresql://deplo:deplo@localhost:5432/deplo_test"

AUTH_SECRET=test-only-not-a-real-secret-000000000000000
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# The E2E server runs at 127.0.0.1:3100, which NextAuth would otherwise reject
# as an untrusted host.
AUTH_TRUST_HOST=true
