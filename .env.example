# Copy to .env and fill in the blanks: cp .env.example .env
# Both the web app (Next.js) and the runner read this file.

# --- Postgres (docker-compose.yaml uses these to create the container) ---
POSTGRES_USER=deplo
POSTGRES_PASSWORD=deplo
POSTGRES_DB=deplo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deplo:deplo@localhost:5432/deplo

# --- Redis (BullMQ job queues shared by the web app and the runner) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth (NextAuth + GitHub OAuth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# From a GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true

# --- Secrets encryption (AES-256-GCM, 32 bytes as 64 hex characters) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Runner ---
# Absolute path to a directory outside this repo, e.g. /tmp/deplo-workspaces or C:/deplo-workspaces.
# Each run gets its own working directory at <RUNNER_WORKSPACE_ROOT>/<runId>
RUNNER_WORKSPACE_ROOT=

# Optional absolute path to this repo. Only the seeded demo pipeline uses it (it runs Deplo's own test suite). e.g., C:\Users\<user>\Desktop\deplo
PROJECT_DIR=
